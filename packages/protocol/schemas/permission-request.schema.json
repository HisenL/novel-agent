{
  "$id": "https://novel-agent.dev/schemas/v1/permission-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "requestedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "const": "user",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "tool",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "requestedCapabilities": {
      "items": {
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "contentDescription": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "costCeiling": {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "minimum": 0,
              "type": "number"
            },
            "currency": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "type": "object"
        },
        "externalDestinations": {
          "items": {
            "format": "uri",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "resourcePaths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "requestedCapabilities",
    "requestedBy",
    "reason",
    "scope",
    "createdAt"
  ],
  "type": "object"
}
