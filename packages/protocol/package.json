{
  "name": "@novel-agent/protocol",
  "version": "0.1.0",
  "description": "Versioned contracts and policy validation for Novel Agent.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/check-schemas.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
